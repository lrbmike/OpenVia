{
  "adapters": {
    "default": "telegram",
    "telegram": {
      "botToken": "your_bot_token_here",
      "allowedUserIds": [123456789, 987654321]
    },
    "feishu": {
      "appId": "your_app_id",
      "appSecret": "your_app_secret",
      "allowedUserIds": ["ou_xxx", "ou_yyy"],
      "wsEndpoint": ""
    }
  },
  "llm": {
    "format": "openai",
    "apiKey": "sk-xxx",
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4o",
    "systemPrompt": "You are a helpful AI assistant. You are running on Windows operating system. Use PowerShell or CMD commands, NOT Linux commands.",
    "timeout": 120000,
    "maxTokens": 4096,
    "maxIterations": 10,
    "duplicateCallSuccessLimit": 1,
    "duplicateCallFailureLimit": 1,
    "bashClassFailureThreshold": 2,
    "bashClassAbortThreshold": 2,
    "enableExperienceEvents": true,
    "autoPromoteExperienceRules": true,
    "autoPromoteScope": "global",
    "autoPromoteThreshold": 3,
    "autoPromoteWindowMinutes": 120,
    "temperature": 0.7,
    "shellConfirmList": ["rm", "mv", "sudo", "su", "dd", "reboot", "shutdown", "del", "rmdir"],
    "skillLoading": "eager"
  },
  "goal": {
    "maxSteps": 20,
    "maxEvaluationRounds": 12,
    "maxReplans": 2,
    "maxStepIterationsSkill": 14,
    "maxStepIterationsDefault": 10,
    "maxStepIterationsNetwork": 12,
    "maxStepIterationsData": 14,
    "maxStepIterationsRemoteTarget": 16,
    "remoteTargetHints": [
      "host:",
      "hostname:",
      "server:",
      "endpoint:",
      "postgresql://",
      "mysql://",
      "mongodb://",
      "redis://",
      "jdbc:",
      ".com",
      ".net",
      ".org"
    ],
    "dataSceneKeywords": [
      "postgres",
      "postgresql",
      "mysql",
      "redis",
      "mongodb",
      "database",
      "数据库",
      "sql",
      "索引",
      "analyze",
      "分析"
    ],
    "networkSceneKeywords": [
      "http",
      "https",
      "api",
      "endpoint",
      "url",
      "fetch",
      "网络",
      "远程",
      "socket"
    ]
  },
  "logging": {
    "level": "info",
    "verbose": false
  }
}
